# Copy to .env and fill in. Only ANTHROPIC_API_KEY, ANTHROPIC_WORKSPACE_ID and AUDIT_* keys are read;
# everything else in them (other API keys, wallets, ...) is ignored and never reaches the agent.

# Claude Console API key that pays for the audits.
ANTHROPIC_API_KEY=
# Needed when the key is not scoped to a workspace; sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# Comma-separated folders whose immediate subfolders are the projects to audit.
AUDIT_ROOTS=/path/to/projects,/path/to/more/projects

# Optional: comma-separated folder names to audit first in every round, in this order.
# AUDIT_PRIORITY=most-important-repo,second-repo

# Comma-separated folder names to skip (exact name, case-insensitive).
AUDIT_EXCLUDE=some-repo,another-repo

# Stop once the estimated spend recorded in the ledger reaches this many USD.
AUDIT_MAX_TOTAL_USD=100

# Where per-session records and full transcripts go (relative to the working directory).
AUDIT_LEDGER=runs/ledger.jsonl
AUDIT_LOG_DIR=logs

# Model and effort for every session.
AUDIT_MODEL=claude-opus-5-5
AUDIT_EFFORT=xhigh

# Optional: your own prompt instead of the bundled fact-check prompt.
# AUDIT_PROMPT_FILE=my_prompt.md

# Optional: no session runs after this ISO time (e.g. when free credits expire); no offset = local time.
# AUDIT_STOP_AT=2026-12-31T23:00:00+00:00

# Optional: wall-clock guard per session in minutes (not a spending cap).
# AUDIT_SESSION_TIMEOUT_MIN=240
